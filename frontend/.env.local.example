NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DATA_EXPLORER_URL=http://localhost:3001
# Same project as api/.env's SUPABASE_URL/SUPABASE_ANON_KEY -- the anon key
# is RLS-scoped and safe to expose to the browser, unlike the service-role
# key (src/supabase_writer.py only, never here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
